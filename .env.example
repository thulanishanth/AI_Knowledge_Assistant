# Sample .env file for AI Knowledge Assistant
# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=hotel_db
DB_TABLE=hotel_reservations

# Model / API Configuration
HF_API_KEY=your_hf_api_key
HF_MODEL=katanemo/Arch-Router-1.5B
CLOUD_API_KEY=your_cloud_api_key

# Application Settings
MAX_QUERY_RESULTS=10
MAX_PREVIEW_ROWS=10
DB_POOL_SIZE=10
DB_QUERY_TIMEOUT_MS=5000
LOG_LEVEL=INFO
LOG_FILE=
STRUCTURED_LOG_JSON=false
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SCHEMA_CACHE_TTL_SECONDS=300
QUERY_CACHE_TTL_SECONDS=45
SESSION_HISTORY_LIMIT=15
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE_SQL=0.0

# Vector / Memory Settings
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_PORT=8000
CHROMA_USE_SSL=false
CHROMA_PERSIST_PATH=./.chroma
VECTOR_COLLECTION_USER=user_memory_collection
VECTOR_COLLECTION_KNOWLEDGE=knowledge_memory_collection
WINDOW_MEMORY_SIZE=10
TOP_K_RETRIEVAL=20
RERANK_TOP_K=5
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_TTL_DAYS=30
MEMORY_IMPORTANCE_THRESHOLD=0.5
ENABLE_RERANKING=true

# Observability
ENABLE_TRACING=false
ENABLE_METRICS=true
OTEL_SERVICE_NAME=ai-knowledge-assistant

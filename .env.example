# Sample .env file for AI Knowledge Assistant
# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=hotel_db
DB_TABLE=hotel_reservations

# Model / API Configuration
HF_API_KEY=your_hf_api_key
HF_MODEL=katanemo/Arch-Router-1.5B
CLOUD_API_KEY=your_cloud_api_key

# Application Settings
MAX_QUERY_RESULTS=10
LOG_LEVEL=INFO
LOG_FILE=
STRUCTURED_LOG_JSON=false

# Vector / Memory Settings
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_PORT=8000
CHROMA_USE_SSL=false
CHROMA_PERSIST_PATH=./.chroma
VECTOR_COLLECTION_USER=user_memory_collection
VECTOR_COLLECTION_KNOWLEDGE=knowledge_memory_collection
WINDOW_MEMORY_SIZE=10
TOP_K_RETRIEVAL=20
RERANK_TOP_K=5
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_TTL_DAYS=30
MEMORY_IMPORTANCE_THRESHOLD=0.5
ENABLE_RERANKING=true

# Observability
ENABLE_TRACING=false
ENABLE_METRICS=true
OTEL_SERVICE_NAME=ai-knowledge-assistant

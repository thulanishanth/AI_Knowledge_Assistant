  "schema_semantics": {
    "identifier_patterns": [
      "_id",
      "id",
      "code",
      "number",
      "reference_no",
      "booking_id",
      "patient_id",
      "order_id",
      "invoice_id",
      "employee_id"
    ],
    "date_patterns": [
      "date",
      "created_at",
      "updated_at",
      "order_date",
      "booking_date",
      "admission_date",
      "discharge_date",
      "appointment_date",
      "transaction_date"
    ],
    "amount_patterns": [
      "amount",
      "price",
      "cost",
      "charge",
      "bill",
      "revenue",
      "profit",
      "balance",
      "payment"
    ],
    "status_patterns": [
      "status",
      "state",
      "result",
      "outcome"
    ],
    "category_patterns": [
      "type",
      "category",
      "segment",
      "channel",
      "department",
      "class"
    ]
  },
  "column_role_registry": [
    {
      "role_name": "primary_identifier",
      "description": "Unique record identifier",
      "examples": [
        "Booking_ID",
        "patient_id",
        "order_id"
      ]
    },
    {
      "role_name": "business_date",
      "description": "Primary date used for business filtering and trending",
      "examples": [
        "order_date",
        "admission_date",
        "arrival_date"
      ]
    },
    {
      "role_name": "status_column",
      "description": "Column that stores lifecycle state",
      "examples": [
        "booking_status",
        "order_status",
        "admission_status"
      ]
    },
    {
      "role_name": "amount_column",
      "description": "Column that stores numeric business amount",
      "examples": [
        "avg_price_per_room",
        "bill_amount",
        "invoice_total"
      ]
    }
  ],
  "ambiguity_resolution_rules": [
    {
      "case": "multiple_status_columns_exist",
      "resolution": "return INSUFFICIENT_CONTEXT unless a primary status column is explicitly mapped"
    },
    {
      "case": "multiple_date_columns_exist",
      "resolution": "return INSUFFICIENT_CONTEXT unless a primary business date is explicitly mapped"
    },
    {
      "case": "multiple_amount_columns_exist",
      "resolution": "return INSUFFICIENT_CONTEXT unless the requested metric is explicitly mapped"
    },
    {
      "case": "user_uses_brand_or_alias_without_mapping",
      "resolution": "return INSUFFICIENT_CONTEXT"
    },
    {
      "case": "user_uses_domain_term_without_mapping",
      "resolution": "return INSUFFICIENT_CONTEXT"
    }
  ],
  "few_shot_repository": [
    {
      "domain": "generic",
      "question": "Show me the first 5 rows.",
      "sql": "SELECT * FROM <table_name> LIMIT 5;"
    },
    {
      "domain": "generic",
      "question": "How many records are there?",
      "sql": "SELECT COUNT(*) FROM <table_name>;"
    },
    {
      "domain": "hotel",
      "question": "What is the average room price for couples who booked via a GDS like Amadeus?",
      "sql": "SELECT AVG(avg_price_per_room) FROM hotel_reservations WHERE no_of_adults = 2 AND no_of_children = 0 AND market_segment_type IN ('Corporate', 'Aviation');"
    },
    {
      "domain": "hospital",
      "question": "How many admitted patients are there this month?",
      "sql": "<explicit_sql_requires_dataset_columns>"
    }
  ],
  "runtime_compilation_rules": {
    "compile_only_active_domain": true,
    "compile_only_active_table": true,
    "include_only_relevant_metric_definitions": true,
    "include_only_relevant_status_mappings": true,
    "include_only_relevant_term_mappings": true,
    "include_only_relevant_examples": true,
    "max_compiled_semantic_rules": 30,
    "max_compiled_constraints": 20,
    "max_compiled_examples": 8,
    "max_compiled_term_mappings": 20,
    "max_compiled_metric_definitions": 15
  },
  "active_context_template": {
    "dataset_name": "<active_dataset_name>",
    "dataset_domain": "<active_domain>",
    "primary_table": "<active_table>",
    "primary_business_date": "<mapped_date_column>",
    "semantic_layer": [],
    "constraints": [],
    "metric_definitions": [],
    "status_mappings": [],
    "term_mappings": [],
    "examples": []
  }
}
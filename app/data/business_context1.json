{
  "version": "1.0.0",
  "context_type": "master_business_context",
  "description": "Production master knowledge registry for cross-domain business SQL grounding. This file is the source of truth and should be compiled into a smaller active context before sending to the LLM.",
  "global_settings": {
    "default_row_limit": 10,
    "strict_mode": true,
    "return_insufficient_context_on_unknown_term": true,
    "disallow_metric_invention": true,
    "disallow_category_guessing": true,
    "disallow_status_guessing": true,
    "disallow_date_column_guessing": true,
    "disallow_join_invention": true,
    "prefer_exact_category_values": true,
    "prefer_single_table_queries_when_possible": true,
    "require_explicit_metric_formula_for_derived_metrics": true,
    "require_explicit_mapping_for_brand_aliases": true,
    "require_explicit_mapping_for_domain_aliases": true
  },
  "prompt_policies": {
    "global_rules": [
      "Use only columns that exist in the active schema.",
      "Use only tables that exist in the active schema.",
      "Never invent metrics, columns, joins, formulas, or category mappings.",
      "If a user term depends on missing business logic, return INSUFFICIENT_CONTEXT.",
      "If multiple date columns exist and the business date is not explicitly mapped, return INSUFFICIENT_CONTEXT.",
      "If a status meaning is not explicitly mapped, return INSUFFICIENT_CONTEXT.",
      "If a brand, channel, department, diagnosis, vendor, partner, or shorthand is not explicitly mapped, return INSUFFICIENT_CONTEXT.",
      "Always limit row-level queries unless the user explicitly requests more rows.",
      "Prefer exact category values from explicit mappings or sample values.",
      "Do not treat identifiers as metrics.",
      "Do not treat count, amount, price, charge, bill, revenue, cost, and profit as interchangeable."
    ],
    "output_rules": [
      "Generate exactly one SQL statement.",
      "Return only SQL or INSUFFICIENT_CONTEXT.",
      "Use SELECT-only queries unless the system explicitly allows otherwise.",
      "Do not include markdown or comments."
    ]
  },
  "shared_business_dictionary": {
    "generic_terms": [
      {
        "term": "count",
        "meaning": "COUNT(*)",
        "requires_explicit_mapping": false
      },
      {
        "term": "average",
        "meaning": "AVG(relevant_numeric_column)",
        "requires_explicit_mapping": false
      },
      {
        "term": "sum",
        "meaning": "SUM(relevant_numeric_column)",
        "requires_explicit_mapping": false
      },
      {
        "term": "minimum",
        "meaning": "MIN(relevant_numeric_column)",
        "requires_explicit_mapping": false
      },
      {
        "term": "maximum",
        "meaning": "MAX(relevant_numeric_column)",
        "requires_explicit_mapping": false
      },
      {
        "term": "latest",
        "meaning": "Use the mapped latest-date column in descending order",
        "requires_explicit_mapping": true
      },
      {
        "term": "oldest",
        "meaning": "Use the mapped earliest-date column in ascending order",
        "requires_explicit_mapping": true
      },
      {
        "term": "top n",
        "meaning": "ORDER BY relevant metric DESC LIMIT N",
        "requires_explicit_mapping": false
      },
      {
        "term": "bottom n",
        "meaning": "ORDER BY relevant metric ASC LIMIT N",
        "requires_explicit_mapping": false
      },
      {
        "term": "trend",
        "meaning": "Group by mapped business date granularity",
        "requires_explicit_mapping": true
      }
    ],
    "generic_entity_types": [
      "customer",
      "patient",
      "guest",
      "student",
      "employee",
      "vendor",
      "supplier",
      "order",
      "booking",
      "invoice",
      "appointment",
      "admission",
      "shipment",
      "transaction",
      "policy",
      "claim",
      "ticket",
      "asset"
    ],
    "generic_aggregation_terms": [
      "count",
      "total",
      "sum",
      "average",
      "avg",
      "minimum",
      "maximum",
      "min",
      "max",
      "median",
      "percent",
      "percentage",
      "ratio"
    ]
  },
  "universal_constraints": {
    "status_rules": [
      "Never assume what success, failure, completion, cancellation, approval, rejection, discharge, closure, or fulfillment means unless explicitly mapped."
    ],
    "time_rules": [
      "Never assume which date column to use unless explicitly mapped for the metric.",
      "Never combine date parts into a full date unless the dataset design explicitly supports it."
    ],
    "metric_rules": [
      "Never invent revenue, profit, occupancy, utilization, conversion, churn, readmission, LOS, AOV, ARPU, or margin formulas unless explicitly defined."
    ],
    "domain_rules": [
      "Never map channels, brands, medical codes, departments, room classes, academic programs, or financial products unless explicitly defined."
    ]
  },
  "domain_modules": {
    "hotel": {
      "domain_name": "hotel",
      "dataset_patterns": [
        "hotel_reservations",
        "room_bookings",
        "hotel_booking_data"
      ],
      "business_date_mappings": {
        "default_business_date": "arrival_date",
        "trend_date": "arrival_date"
      },
      "entity_definitions": [
        {
          "term": "couples",
          "sql_condition": "no_of_adults = 2 AND no_of_children = 0"
        },
        {
          "term": "family",
          "sql_condition": "no_of_children > 0"
        },
        {
          "term": "repeated guest",
          "sql_condition": "repeated_guest = 1"
        },
        {
          "term": "new guest",
          "sql_condition": "repeated_guest = 0"
        }
      ],
      "channel_mappings": [
        {
          "term": "gds",
          "sql_condition": "market_segment_type IN ('Corporate', 'Aviation')"
        },
        {
          "term": "amadeus",
          "sql_condition": "market_segment_type IN ('Corporate', 'Aviation')"
        },
        {
          "term": "ota",
          "sql_condition": "market_segment_type = 'Online'"
        },
        {
          "term": "walk-in",
          "sql_condition": "market_segment_type = 'Offline'"
        },
        {
          "term": "direct booking",
          "sql_condition": "market_segment_type = 'Offline'"
        }
      ],
      "status_mappings": [
        {
          "term": "successful booking",
          "sql_condition": "booking_status = 'Not_Canceled'"
        },
        {
          "term": "completed booking",
          "sql_condition": "booking_status = 'Not_Canceled'"
        },
        {
          "term": "cancelled booking",
          "sql_condition": "booking_status = 'Canceled'"
        }
      ],
      "metric_definitions": [
        {
          "metric_name": "average_room_price",
          "formula_sql": "AVG(avg_price_per_room)"
        },
        {
          "metric_name": "total_bookings",
          "formula_sql": "COUNT(*)"
        },
        {
          "metric_name": "average_total_stay_nights",
          "formula_sql": "AVG(no_of_weekend_nights + no_of_week_nights)"
        }
      ],
      "forbidden_assumptions": [
        "Do not invent total revenue unless the dataset explicitly defines revenue logic.",
        "Do not invent occupancy unless inventory fields exist."
      ]
    },
